# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION
# Managed automatically by cPanel CloudLinux Node.js Selector
PassengerEnabled On

# Protect sensitive server files and configs
Options -Indexes

<FilesMatch "(?i)^(\.env.*|.*\.sql|.*\.log|package.*\.json|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
