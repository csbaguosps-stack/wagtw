# WAGTW - Disable Script Execution in Uploads Directory
# Coding by cs.baguosps@gmail.com

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phar|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
