@echo off
title Buat Zip Bersih untuk cPanel
echo Membuat arsip wagtw_cpanel_ready.zip tanpa node_modules...
node -e "const fs = require('fs'); const path = require('path'); const cp = require('child_process'); const tempDir = './dist_cpanel'; if (fs.existsSync(tempDir)) fs.rmSync(tempDir, {recursive: true, force: true}); fs.mkdirSync(tempDir, {recursive: true}); function copyRecursive(src, dest, ignoreDirs = []) { const stat = fs.statSync(src); if (stat.isDirectory()) { if (ignoreDirs.includes(path.basename(src))) return; fs.mkdirSync(dest, {recursive: true}); for (const item of fs.readdirSync(src)) { copyRecursive(path.join(src, item), path.join(dest, item), ignoreDirs); } } else { if (ignoreDirs.includes(path.basename(src))) return; fs.copyFileSync(src, dest); } } copyRecursive('./app', './dist_cpanel/app'); copyRecursive('./public', './dist_cpanel/public', ['unlock.php', 'fix_cpanel.php']); copyRecursive('./server', './dist_cpanel/server', ['node_modules', '.sessions', 'node_error.log', 'node_output.log', 'server.log', 'server_err.log', '.env', 'temp.env']); fs.copyFileSync('./.htaccess', './dist_cpanel/.htaccess'); if (fs.existsSync('./database.sql')) fs.copyFileSync('./database.sql', './dist_cpanel/database.sql'); cp.execSync('tar -a -cf wagtw_cpanel_ready.zip -C ./dist_cpanel .'); fs.rmSync(tempDir, {recursive: true, force: true}); console.log('Sukses! File wagtw_cpanel_ready.zip siap diupload ke cPanel.');"
pause
