# WAGTW - Root Apache Configuration
# Coding by cs.baguosps@gmail.com

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent cPanel Passenger /server Node.js endpoint from being rewritten to public
    RewriteCond %{REQUEST_URI} ^/server [NC]
    RewriteRule ^ - [L]

    # Rewrite all other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Protect sensitive environment, database, log, and diagnostic files
<FilesMatch "(?i)^(\.env.*|.*\.sql|.*\.log|\.git.*|fix_cpanel\.php|unlock\.php|test_.*\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
